{
  "name": "localmemo",
  "version": "1.0.0",
  "description": "LocalMemo is a lightweight notes and tasks app built with vanilla HTML, CSS, and JavaScript. Everything is stored locally in the browser, with optional private GitHub Gist sync for backup.",
  "main": "github-sync.js",
  "scripts": {
    "dev": "tauri dev",
    "build:frontend": "node scripts/build-frontend.js",
    "build": "npm run build:frontend && tauri build",
    "tauri": "tauri",
    "icons:generate": "node scripts/generate-icons.js",
    "clean": "node scripts/clean.js",
    "reinstall": "npm run clean && npm install",
    "test": "echo \"No tests configured\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realsnywy/LocalMemo.git"
  },
